{
  "version": 1,
  "workspaceManifestDefaults": {
    "melos": {
      "file": "melos.yaml",
      "listKey": "packages",
      "defaultGlobs": ["packages/*"]
    },
    "pnpm": {
      "file": "pnpm-workspace.yaml",
      "listKey": "packages",
      "defaultGlobs": []
    },
    "lerna": {
      "file": "lerna.json",
      "jsonField": "packages",
      "defaultGlobs": ["packages/*"]
    }
  },
  "projectManifestFiles": ["package.json", "pubspec.yaml"],
  "projectConfigFiles": [
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.base.json",
    "biome.json",
    "biome.jsonc",
    "eslint.config.js",
    "eslint.config.mjs",
    "eslint.config.cjs",
    "eslint.config.ts",
    ".eslintrc",
    ".eslintrc.json",
    ".eslintrc.js",
    ".eslintrc.cjs",
    ".eslintrc.yml",
    ".eslintrc.yaml",
    "analysis_options.yaml",
    "vite.config.ts",
    "vite.config.js",
    "vite.config.mjs",
    "vite.config.cjs",
    "astro.config.ts",
    "astro.config.js",
    "astro.config.mjs",
    "astro.config.cjs",
    "next.config.ts",
    "next.config.js",
    "next.config.mjs",
    "next.config.cjs",
    "vitest.config.ts",
    "vitest.config.js",
    "jest.config.js",
    "jest.config.ts",
    "wrangler.toml",
    "wrangler.json",
    "wrangler.jsonc"
  ],
  "sourceRoots": ["src", "app", "lib"],
  "rootSourceRoots": ["src", "web/src", "lib", "app"],
  "testRoots": ["test", "tests", "__tests__", "e2e"],
  "sourceFileExtensions": [".ts", ".tsx", ".js", ".jsx", ".dart", ".vue", ".svelte"],
  "frontendFrameworks": ["react", "vue", "svelte"],
  "projectKindRules": {
    "appRoots": ["apps", "web", "client", "frontend"],
    "serviceRoots": ["services", "api", "server", "backend", "workers", "functions", "jobs", "tasks"],
    "libraryRoots": ["packages", "libs", "libraries", "lib"],
    "servicePathIncludes": ["worker"],
    "libraryPathIncludes": ["shared"]
  },
  "confidenceScoring": {
    "base": 0.35,
    "manifestFileBonus": 0.35,
    "configFileBonus": 0.15,
    "sourceRootBonus": 0.1,
    "manifestEvidenceBonus": 0.05,
    "conventionEvidencePenalty": 0.05
  },
  "pairedConventionLayouts": [
    ["apps", "packages"],
    ["apps", "libs"],
    ["services", "packages"],
    ["server", "client"],
    ["backend", "frontend"]
  ],
  "conventionalContainerRoots": [
    "apps",
    "packages",
    "libs",
    "libraries",
    "services",
    "workers",
    "functions",
    "jobs",
    "tasks",
    "web",
    "sites",
    "frontends",
    "clients",
    "api",
    "server",
    "backend",
    "mobile",
    "ios",
    "android",
    "desktop",
    "tools",
    "scripts",
    "cli",
    "examples",
    "samples"
  ],
  "staticSiteRootNames": ["site", "docs", "website", "web", "public", "static"],
  "componentConfigFiles": ["wrangler.toml", "wrangler.json", "wrangler.jsonc"],
  "linterConfigFiles": [
    "biome.json",
    "biome.jsonc",
    "analysis_options.yaml",
    ".eslintrc.json",
    ".eslintrc.js",
    "eslint.config.js",
    "eslint.config.ts",
    "eslint.config.mjs"
  ],
  "ignoredConventionEntries": ["node_modules", ".git", "dist", "build"]
}
