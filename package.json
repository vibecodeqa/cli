{
	"name": "@vibecodeqa/cli",
	"version": "0.40.0",
	"description": "Code health scanner for the AI coding era. 25 checks, zero config, full report.",
	"type": "module",
	"bin": {
		"vcqa": "./dist/cli.js",
		"vibe-check": "./dist/cli.js"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"scripts": {
