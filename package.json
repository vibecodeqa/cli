	"repository": {
		"type": "git",
		"url": "https://github.com/vibecodeqa/cli"
	},
	"homepage": "https://vibecodeqa.online",
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/node": "^25.8.0",
		"@types/react": "^18.3.29",
		"typescript": "^5.8.3",
		"vitest": "^4.1.6"
	},
	"dependencies": {
		"@jscpd/core": "^4.2.4",
